      <aliases enabled='yes' />
      <column caption='Top Brand Flag' datatype='string' name='[Calculation_0510501201244160]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [presence_world] &gt;= 2000 OR [plans] &gt;= 100 THEN &quot;Top players&quot;&#13;&#10;ELSE &quot;Other brands&quot;&#13;&#10;END' />
      </column>
      <column caption='Top Label' datatype='string' name='[Calculation_0510501229977601]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [presence_world] &gt;= 2000 THEN &quot;Etam — high presence, low expansion&quot;&#13;&#10;END' />
      </column>
      <column caption='Etam Flag' datatype='string' name='[Calculation_0894506654347264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [name] = &quot;Etam&quot; THEN&#13;&#10;&quot;Etam — high presence, low expansion&quot;&#13;&#10;END' />
      </column>
      <column caption='Presence Size Highlight' datatype='integer' name='[Calculation_0894506658267138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [name] = &quot;Etam&quot; THEN [presence_world] * 3&#13;&#10;ELSE [presence_world]&#13;&#10;END' />
      </column>
